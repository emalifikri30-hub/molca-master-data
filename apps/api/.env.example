# Copy to .env and fill in. DATABASE_URL: set it in the shell for migrate/seed (never rely on .env there).
# Required (loadConfig throws when one is missing):
PORT=3002
APPLICATION_ALIAS=
REGION_CODE=
DATABASE_URL=
OIDC_HOST=https://identity.mes.molca.id
OIDC_BASE_URI=https://identity.mes.molca.id/realms/dx-molca
OIDC_TOKEN_URI=https://identity.mes.molca.id/realms/dx-molca/protocol/openid-connect/token
OIDC_CLIENT_ID=dx-master-data
OIDC_CLIENT_SECRET=
KEYCLOAK_REALMS=dx-molca
# Optional:
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_MAX_CONN=20
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONN_TIMEOUT_MS=5000
KEYCLOAK_TIMEOUT=30000
# IANA zone that decides "today" for a tenant's validity (TNT-G8 b). Default: the server's zone.
INSTALL_TIME_ZONE=Asia/Jakarta
PROXY_UPSTREAM_TIMEOUT_MS=

# --- Production Planning (upstream) ---
# PLANNING_API_URL is required: loadConfig throws when it is unset, and there is no default.
# Give dx-production-planning's own base URL. Its port is not this API's PORT above.
# The old code fell back to http://localhost:3202, so a missing value used to be silent.
PLANNING_API_URL=
# Timeout per call to Planning, in milliseconds (positive integer). Default: 5000.
PLANNING_TIMEOUT_MS=5000

# Token checks (README, "API token checks"). Both are off when unset.
#
# AUTH_AUDIENCE: KEEP UNSET until the realm has an audience mapper that puts dx-master-data
# in `aud` for EVERY caller below. Keycloak tokens carry `aud: account` (service accounts:
# `realm-management`) by default, so setting it without the mapper 401s everyone, this
# API's own BFF included. The API logs a warning at start-up whenever it is set.
AUTH_AUDIENCE=
# AUTH_ALLOWED_AZP: when set, it must list EVERY caller, or that caller 401s:
#   dx-master-data          this app's BFF (the signed-in person)
#   dx-master-data-svc      this app's own service account
#   dx-platform-svc         dx-platform provisioning (/platform/* routes)
#   dx-user-management-svc  USR reading the Site Hierarchy (X-Tenant-Id, contract §0b)
#   dx-user-management      USR's tenant check, which forwards the signed-in person's token
#                           to GET /api/v1/tenant (and the same for every other module's
#                           browser client whose tenant check does so)
#   dx-production-planning  Planning's tenant check (browser client) + -svc its service account
#   dx-production-reports   Monitoring/Performance's tenant check (browser client) + -svc its service account
# AUTH_ALLOWED_AZP=dx-master-data,dx-master-data-svc,dx-platform-svc,dx-user-management-svc,dx-user-management,dx-production-planning,dx-production-planning-svc,dx-production-reports,dx-production-reports-svc
AUTH_ALLOWED_AZP=
