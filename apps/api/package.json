{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "test": "vp test",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "build": "tsc && vp build",
    "start": "node --import ./instrumentation.mjs dist/index.js",
    "db:check": "drizzle-kit check",
    "db:gen": "drizzle-kit generate",
    "db:push": "drizzle-kit migrate",
    "db:seed": "node --import ./src/shared/database/seed-loader.mjs --experimental-strip-types --env-file=.env src/shared/database/seed-fi2.ts",
    "db:seed:kpi": "node --import ./src/shared/database/seed-loader.mjs --experimental-strip-types --env-file=.env src/shared/database/seed-fi2.ts --kpi-only",
    "db:seed:flows": "node --import ./src/shared/database/seed-loader.mjs --experimental-strip-types --env-file=.env src/shared/database/seed-fi2.ts --flows-only",
    "db:seed:shifts": "node --import ./src/shared/database/seed-loader.mjs --experimental-strip-types --env-file=.env src/shared/database/seed-fi2.ts --shifts-only",
    "db:assign-tenant": "node --import ./src/shared/database/seed-loader.mjs --experimental-strip-types --env-file=.env src/shared/database/assign-tenant.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.5",
    "@hono/otel": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@loglayer/plugin-opentelemetry": "catalog:",
    "@loglayer/transport-pino": "catalog:",
    "@molca/contract-client": "workspace:*",
    "@molca/helper": "workspace:*",
    "@molca/mes": "catalog:",
    "@molca/network": "workspace:*",
    "@molca/observability": "workspace:*",
    "@molca/security": "workspace:*",
    "@molca/utils": "workspace:*",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-proto": "catalog:",
    "@opentelemetry/exporter-trace-otlp-proto": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-undici": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "awilix": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^1.0.0-beta.22",
    "hono": "^4.12.26",
    "jose": "catalog:",
    "loglayer": "catalog:",
    "openid-client": "catalog:",
    "pg": "^8.20.0",
    "pino": "catalog:",
    "pino-pretty": "catalog:",
    "ulidx": "^2.4.1",
