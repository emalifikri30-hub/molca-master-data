    "@hono/vite-dev-server": "catalog:",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^1.0.0-beta.22",
    "msw": "catalog:",
    "typescript": "^5.8.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
